# The FFmpeg that ships inside Lexpad (the video player's media engine), pinned.
# Every value here is checked by the scripts beside this file; see docs/ffmpeg.md
# for the licence (LGPL 2.1 or later, no GPL or nonfree part) and where the
# source of each binary is.

# macOS: built from source on the Mac by build-macos.sh (universal: arm64 + x86_64).
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
# zimg (WTFPL): zscale, used for HDR to SDR tone-mapping.
ZIMG_VERSION=3.0.6
ZIMG_URL=https://github.com/sekrit-twc/zimg/archive/refs/tags/release-3.0.6.tar.gz
ZIMG_SHA256=be89390f13a5c9b2388ce0f44a5e89364a20c1c57ce46d382b1fcc3967057577
# dav1d (BSD-2-Clause): the AV1 decoder.
DAV1D_VERSION=1.5.4
DAV1D_URL=https://code.videolan.org/videolan/dav1d/-/archive/1.5.4/dav1d-1.5.4.tar.gz
DAV1D_SHA256=a1d5b63d2d38ec9bd03acf643caa51fa22edd1e89c5a109c4807717216bbec07

# Windows (and Linux, for CI's tests only; Linux is not shipped): the LGPL
# static builds of BtbN/FFmpeg-Builds, from a monthly release (those are kept;
# the daily ones are pruned). Same FFmpeg release as the Mac.
BTBN_TAG=autobuild-2026-09-30-13-08
BTBN_WIN64=ffmpeg-n9.0.2-17-g2a571b6068-win64-lgpl-9.0
BTBN_WIN64_SHA256=6b264b9e6019103f601d98c292bd332fd87acf1c5e941ddff4fb71760fe63432
BTBN_LINUX64=ffmpeg-n9.0.2-17-g2a571b6068-linux64-lgpl-9.0
BTBN_LINUX64_SHA256=2d41cbea0ca1a15029b638330740f78d6f5aeb062355bf425433fc938705350a
