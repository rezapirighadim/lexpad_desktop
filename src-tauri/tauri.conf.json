{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexpad",
  "version": "../package.json",
  "identifier": "app.lexpad.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popup",
        "url": "popup.html",
        "title": "Lexpad",
        "width": 360,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": true,
        "focus": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Lexpad Settings",
        "width": 520,
        "height": 680,
        "minWidth": 440,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["popup", "panel", "settings"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Education",
    "publisher": "Lexpad",
    "copyright": "© 2026 Lexpad",
    "shortDescription": "Add a word to Lexpad from any app",
    "longDescription": "Select a word in any app, press the Lexpad shortcut, and see its meaning while it goes into your Lexpad notebook with the sentence you met it in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
