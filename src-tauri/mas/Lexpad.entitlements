<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac App Store build's entitlements (docs/mac-app-store-plan.md, "Sandbox").
  Every key here is needed by something the app does; nothing else is asked for.
  scripts/release-mas.sh signs Lexpad.app with this file; the local test build
  (release-mas.sh with its local flag) drops the identity keys and Sign in with Apple, which
  only a provisioning profile may grant.
-->
<plist version="1.0">
<dict>
  <!-- App Review Guideline 2.4.5(i): every Mac App Store app is sandboxed. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- The API (api.lexpad.app), lexpad.app's pages opened in the browser.
       Nothing listens: signing in comes back as lexpad://auth/callback
       (Info.mas.plist, auth.rs), so there is no network.server key. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- The video player plays the films and subtitles the learner chooses,
       drops or opens with Lexpad; it only reads them. -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <!-- Settings → Import & export → Export writes the notebook's file to
       Downloads (src/export.rs, save_export): a new file each time, nothing
       there is read or changed. -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <!-- The Player's Say it back: the microphone, for WebKit's speech
       recognition (macOS still asks the learner first). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The Mac App Store identity, from the provisioning profile. -->
  <key>com.apple.application-identifier</key>
  <string>6Z95MR26LZ.app.lexpad.ios</string>
  <key>com.apple.developer.team-identifier</key>
  <string>6Z95MR26LZ</string>
  <!-- Sign in with Apple in Apple's own sheet, so it finishes inside the app
       (App Review Guideline 4; src/signin_mas.rs). The App ID has the
       capability and the provisioning profile grants it. -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>
</dict>
</plist>
