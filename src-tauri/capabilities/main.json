{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Lexpad's window, the whole web app: every API call through the core (which holds the session and checks each call), whether there is a session, connecting in the browser and signing out, a page of the web app in the browser, the desktop section of Settings (shortcut, reading the selection, quick-add notebook, start-up, notifications), the reminder plan the newest desktop versions on lexpad.app (read by the core), and the video player's media engine (files only by the ids the core gave for what the learner dropped or chose; the stream over the lexmedia scheme). Nothing else: no file system, no shell, no window control.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-api-fetch",
    "allow-main-signed-in",
    "allow-main-take-pending",
    "allow-connect",
    "allow-cancel-connect",
    "allow-disconnect",
    "allow-open-in-browser",
    "allow-desktop-settings",
    "allow-set-shortcut",
    "allow-set-start-on-login",
    "allow-set-open-on-launch",
    "allow-set-open-in-browser",
    "allow-set-notebook",
    "allow-accessibility",
    "allow-open-accessibility-settings",
    "allow-set-notifications",
    "allow-schedule-reminders",
    "allow-open-notification-settings",
    "allow-app-info",
    "allow-latest-release",
    "allow-media-engine",
    "allow-media-pick",
    "allow-media-take-pending",
    "allow-media-probe",
    "allow-media-open",
    "allow-media-seek",
    "allow-media-set-audio",
    "allow-media-close",
    "allow-media-subtitles",
    "allow-media-subtitle-load",
    "allow-media-subtitle-offset",
    "allow-media-episodes",
    "allow-media-resume-save",
    "allow-media-default-player-status",
    "allow-media-default-player-request",
    "allow-words-save",
    "allow-words-pending",
    "allow-words-flush",
    "allow-words-discard",
    "allow-media-default-player-restore",
    "allow-media-recent",
    "allow-media-recent-remove",
    "allow-media-recent-clear",
    "allow-media-set-remember-recent",
    "allow-media-prefs"
  ]
}
