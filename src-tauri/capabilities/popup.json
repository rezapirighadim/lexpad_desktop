{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popup",
  "description": "The add-a-word popup: reads the account's notebooks, looks a word up and adds it, is dragged by its header, and opens the web app's report page for its AI-written meaning. Nothing else.",
  "windows": ["popup"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-state",
    "allow-lookup",
    "allow-add-word",
    "allow-set-notebook",
    "allow-connect",
    "allow-cancel-connect",
    "allow-hide-popup",
    "allow-fit-popup",
    "allow-accessibility",
    "allow-open-accessibility-settings",
    "allow-open-settings",
    "allow-open-report"
  ]
}
