    "details": [
      {
        "appIDs": [
          "6Z95MR26LZ.app.lexpad.ios"
        ],
        "components": [
          {
            "/": "//*",
            "exclude": true,
            "comment": "an address with a doubled slash is not one Lexpad sends; it stays in Safari rather than slip past the excludes below"
          },
          {
            "/": "/*//*",
            "exclude": true
          },
          {
            "/": "/promo",
            "exclude": true,
            "comment": "promotion codes stay in Safari: Apple allows no code of ours to unlock Pro (Guideline 3.1.1)",
            "caseSensitive": false
          },
          {
            "/": "/promo/*",
            "exclude": true,
            "caseSensitive": false
          },
          {
            "/": "/settings/plan",
            "exclude": true,
            "comment": "purchase links (an e-mail's web offer, Paddle checkout) stay in Safari; never an in-app web checkout (3.1.1)",
            "caseSensitive": false
          },
          {
            "/": "/settings/plan/*",
            "exclude": true,
            "caseSensitive": false
          },
          {
            "/": "/auth",
            "exclude": true,
            "comment": "sign-in and Google's callback return to the browser that asked"
          },
          {
            "/": "/auth/*",
            "exclude": true
          },
          {
            "/": "/connect",
            "exclude": true,
            "comment": "assistants, the desktop app and the extension are approved in the browser that started them"
